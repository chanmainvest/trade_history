# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed.
#
# Used by the yahoo-upload skill (.zcode/skills/yahoo-upload) to sign in to
# Yahoo Finance when uploading the portfolio CSV exported by
# GET /export/yahoo-csv (Monthly tab, "Export Yahoo CSV").

YAHOO_USER=your_yahoo_email@example.com
YAHOO_PASSWORD=your_yahoo_password
